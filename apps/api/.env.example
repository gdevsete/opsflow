NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://opsflow_app:opsflow_app_password@localhost:5432/opsflow_db
# Used only by the migration script and local integration-test cleanup.
DATABASE_ADMIN_URL=postgres://opsflow_admin:opsflow_dev_password@localhost:5432/opsflow_db
JWT_SECRET=local-development-only-change-me-to-a-random-32-character-secret
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Comma-separated exact origins are supported for local and deployed frontends.
CORS_ORIGIN=http://localhost:5173
